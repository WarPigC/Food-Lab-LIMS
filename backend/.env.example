# ========================================================
# FoodLab LIMS (AIPER) - Backend Environment Configuration
# ========================================================

# Server Port and Node Environment
PORT=5000
NODE_ENV=production

# Server Timezone (Must be Asia/Kolkata for accurate date-based job codes and ULRs)
TZ=Asia/Kolkata

# MongoDB Atlas Connection URI (can also be specified as MONGO_URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/prod_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Starting integer for 4-digit sample serial counter (e.g. 1000 or 1100)
SAMPLE_ID_START=1100

# Frontend URL for CORS configuration (same-origin domain behind Caddy reverse proxy)
FRONTEND_URL=https://acrocsit.in

# Logging System (Winston with MongoDB transport)
LOG_LEVEL=info
LOG_DB_ENABLED=true

# Optional: Brevo Email API (for automated OTP verification and bug reports)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@acrocsit.in
