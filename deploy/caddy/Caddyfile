# Caddy Configuration for ftl.acrocsit.in
# Target Server Location: ~/stacks/caddy/Caddyfile

ftl.acrocsit.in {
    encode gzip zstd

    handle /api/* {
        reverse_proxy foodlab-backend:5000
    }

    handle /socket.io/* {
        reverse_proxy foodlab-backend:5000
    }

    handle {
        reverse_proxy foodlab-frontend:80
    }
}

acrocsit.in, www.acrocsit.in {
    redir https://ftl.acrocsit.in{uri} permanent
}