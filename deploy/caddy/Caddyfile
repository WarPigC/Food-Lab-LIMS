# Caddy Configuration for ftl.acrocsit.in
# Target Server Location: ~/stacks/caddy/Caddyfile

ftl.acrocsit.in {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /api/* {
        reverse_proxy foodlab-backend:5000
    }

    handle /socket.io/* {
        reverse_proxy foodlab-backend:5000
    }

    handle {
        reverse_proxy foodlab-frontend:80
    }
}

acrocsit.in, www.acrocsit.in {
    redir https://ftl.acrocsit.in{uri} 301
}
